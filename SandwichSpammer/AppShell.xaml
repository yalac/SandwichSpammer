<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:pages="clr-namespace:SandwichSpammer"
       x:Class="SandwichSpammer.AppShell">

    <TabBar>
        <Tab Title="Accueil" Icon="sandwich.png">
            <ShellContent ContentTemplate="{DataTemplate pages:MainPage}" Route="MainPage" />
        </Tab>
        <Tab Title="Boutique" Icon="boutique.png">
            <ShellContent ContentTemplate="{DataTemplate pages:Boutique}" Route="Boutique" />
        </Tab>
    </TabBar>
</Shell>
