<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SandwichSpammer.ViewModels"
             xmlns:model="clr-namespace:SandwichSpammer.Models"
             x:Class="SandwichSpammer.MainPage"
             x:DataType="vm:AccompanimentViewModel"
             BackgroundColor="{DynamicResource PageBackgroundColor}">

    <Grid RowDefinitions="Auto,*">
        <VerticalStackLayout Padding="12" Spacing="8" Grid.Row="0" HorizontalOptions="FillAndExpand">
            <!-- Total calories -->
            <Label x:Name="CaloriesLabel"
                   Text="{Binding Counter, StringFormat='{0} Calories'}"
                   Style="{DynamicResource HeaderLabelStyle}"
                   HorizontalOptions="Center">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="CaloriesLabel_Tapped" NumberOfTapsRequired="1" />
                </Label.GestureRecognizers>
            </Label>
            <!-- Zone d'entrée demandée + bouton -->
            <HorizontalStackLayout Spacing="8" VerticalOptions="Center" HorizontalOptions="CenterAndExpand">
                <Entry Placeholder="Saisir accompagnement... (+100 cal/click)" Text="{Binding EntryText}" WidthRequest="220" HorizontalOptions="Start" />
                <Button Text="Vérifier" Command="{Binding CheckEntryCommand}" />
                <Label Text="{Binding EntryStatus}" x:Name="StatusLabel" VerticalOptions="Center" FontAttributes="Bold">
                    <Label.Triggers>
                        <DataTrigger TargetType="Label" Binding="{Binding EntryStatus}" Value="Succès">
                            <Setter Property="TextColor" Value="LimeGreen" />
                        </DataTrigger>
                        <DataTrigger TargetType="Label" Binding="{Binding EntryStatus}" Value="Échec">
                            <Setter Property="TextColor" Value="Tomato" />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>
            </HorizontalStackLayout>
        </VerticalStackLayout>

        <ScrollView Grid.Row="1">
            <AbsoluteLayout Grid.Row="1" Padding="10">
                <!-- Bouton sandwich central -->
                <ImageButton x:Name="SandwichButton"
                             Source="sandwichclick.png"
                             WidthRequest="300"
                             HeightRequest="300"
                             Command="{Binding IncrementCounterCommand}"
                             BackgroundColor="Transparent"
                             AbsoluteLayout.LayoutBounds="0.5,0.45,300,300"
                             AbsoluteLayout.LayoutFlags="PositionProportional" />

                <!-- Cheerleaders (visibilité contrôlée depuis code-behind via BoutiqueViewModel) -->
                <Image x:Name="UpgradeCheerleader1" Source="cheerleaders.gif" HeightRequest="60" WidthRequest="60" IsAnimationPlaying="True" IsVisible="False" AbsoluteLayout.LayoutBounds="0.06,0.40,60,60" AbsoluteLayout.LayoutFlags="PositionProportional" />
                <Image x:Name="UpgradeCheerleader2" Source="cheerleaders.gif" HeightRequest="60" WidthRequest="60" IsAnimationPlaying="True" IsVisible="False" AbsoluteLayout.LayoutBounds="0.93,0.32,60,60" AbsoluteLayout.LayoutFlags="PositionProportional" />
                <Image x:Name="UpgradeCheerleader3" Source="cheerleaders.gif" HeightRequest="60" WidthRequest="60" IsAnimationPlaying="True" IsVisible="False" AbsoluteLayout.LayoutBounds="0.88,0.65,60,60" AbsoluteLayout.LayoutFlags="PositionProportional" />

                <Label Text="{Binding ClickBonus, StringFormat='{0} cal/click'}" FontSize="14" HorizontalOptions="End" />
            </AbsoluteLayout>
        </ScrollView>
    </Grid>
</ContentPage>
