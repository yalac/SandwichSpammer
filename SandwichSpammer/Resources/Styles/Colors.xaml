<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Palette sombre / violet -->
    <Color x:Key="PageBackgroundColor">#0B0711</Color>        <!-- fond très sombre -->
    <Color x:Key="Surface">#121018</Color>                    <!-- surfaces (cards, frames) -->
    <Color x:Key="SurfaceAlt">#1A1323</Color>                 <!-- surfaces alternatives -->
    <Color x:Key="Primary">#8A5CFF</Color>                    <!-- violet principal -->
    <Color x:Key="PrimaryDark">#5E2EDB</Color>
    <Color x:Key="Accent">#D6B3FF</Color>                     <!-- accent clair -->
    <Color x:Key="Secondary">#2E1A3C</Color>                  <!-- panel bas -->
    <Color x:Key="SecondaryLight">#3A234F</Color>

    <!-- Textes / contrastes -->
    <Color x:Key="TextPrimary">#F5F5F7</Color>                <!-- texte principal (clair) -->
    <Color x:Key="TextSecondary">#CFC8D8</Color>              <!-- sous-texte -->
    <Color x:Key="Muted">#8F86A0</Color>

    <!-- Neutres sombres pour bordures / séparateurs -->
    <Color x:Key="Border">#2A2430</Color>
    <Color x:Key="Divider">#241B2A</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="{StaticResource PrimaryDark}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource Surface}"/>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource SurfaceAlt}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="PageBackgroundBrush" Color="{StaticResource PageBackgroundColor}"/>

</ResourceDictionary>
